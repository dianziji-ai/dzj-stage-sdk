{
  "name": "dzj-stage-sdk",
  "private": true,
  "description": "电子姬舞台 SDK（monorepo）：@dianziji/stage 及配套包",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/stage",
    "packages/stage-settings",
    "packages/stage-panel",
