{
  "name": "@dianziji/stage-panel",
  "version": "0.2.3",
  "description": "电子姬舞台面板：每个舞台都带的「本局」面板（概览 / 初始设定 / 图册 / 存档 / 分区 / 指南，所有人都能看；开发凭证多出凭证细节）",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianziji-ai/dzj-stage-sdk.git",
    "directory": "packages/stage-panel"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@dianziji/stage": ">=0.3.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3"
  }
}
