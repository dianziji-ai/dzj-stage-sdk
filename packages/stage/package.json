{
  "name": "@dianziji/stage",
  "version": "0.4.1",
  "description": "电子姬舞台 SDK：客户端（读这一局 / 发一句话收流 / 存档）+ 会话引擎 + React 外壳",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianziji-ai/dzj-stage-sdk.git",
    "directory": "packages/stage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "micromark": "^4.0.3",
    "use-sync-external-store": "^1.7.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3"
  }
}
